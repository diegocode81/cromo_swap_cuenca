DATABASE_URL=
DIRECT_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
CRON_SECRET=
RESEND_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
SEED_ADMIN_EMAIL=admin@cromoswap.ec
SEED_ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# CONTROL DE ACTUALIZACIÓN MANUAL DE APK
# ─────────────────────────────────────────────────────────────────────────────
# Controla si se muestra el modal "Nueva versión disponible" en el APK Android.
#
# false (por defecto) → Modal desactivado. Usar en versión publicada en Google Play.
#                       Google Play gestiona las actualizaciones automáticamente.
#
# true               → Modal activado. Usar SOLO para distribución manual de APK
#                       fuera de Google Play (pruebas, sideloading, etc.)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_APK_UPDATE_CHECK=false

# Token opcional para ejecutar POST /api/admin/cities/seed sin sesion admin.
# Usar solo en operaciones controladas de produccion.
CITIES_SEED_TOKEN=
